generator client {
  provider     = "prisma-client-js"


}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model gyakorlatok {
  id                                                                 Int                     @id @default(autoincrement())
  nev                                                                String                  @db.VarChar(100)
  elsodleges_izomcsoport_id                                          Int
  masodlagos_izomcsoport_id                                          Int?
  edzesterv_gyakorlatok                                              edzesterv_gyakorlatok[]
  sessionExercises                                                   SessionExercise[]
  izomcsoportok_gyakorlatok_elsodleges_izomcsoport_idToizomcsoportok izomcsoportok           @relation("gyakorlatok_elsodleges_izomcsoport_idToizomcsoportok", fields: [elsodleges_izomcsoport_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gyakorlatok_ibfk_1")
  izomcsoportok_gyakorlatok_masodlagos_izomcsoport_idToizomcsoportok izomcsoportok?          @relation("gyakorlatok_masodlagos_izomcsoport_idToizomcsoportok", fields: [masodlagos_izomcsoport_id], references: [id], onUpdate: Restrict, map: "gyakorlatok_ibfk_2")

  @@index([elsodleges_izomcsoport_id], map: "elsodleges_izomcsoport_id")
  @@index([masodlagos_izomcsoport_id], map: "masodlagos_izomcsoport_id")
}

model izomcsoportok {
  id                                                               Int           @id @default(autoincrement())
  nev                                                              String        @unique(map: "izomcsoportok_nev_key") @db.VarChar(50)
  gyakorlatok_gyakorlatok_elsodleges_izomcsoport_idToizomcsoportok gyakorlatok[] @relation("gyakorlatok_elsodleges_izomcsoport_idToizomcsoportok")
  gyakorlatok_gyakorlatok_masodlagos_izomcsoport_idToizomcsoportok gyakorlatok[] @relation("gyakorlatok_masodlagos_izomcsoport_idToizomcsoportok")
}

model edzes_napok {
  id                    Int                     @id @default(autoincrement())
  edzesterv_id          Int
  nev                   String                  @db.VarChar(100)
  sorrend               Int                     @default(1)
  edzestervek           edzestervek             @relation(fields: [edzesterv_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "edzes_napok_ibfk_1")
  edzesterv_gyakorlatok edzesterv_gyakorlatok[]
  workoutSessions      WorkoutSession[]

  @@index([edzesterv_id], map: "edzesterv_id")
  @@unique([edzesterv_id, sorrend])
}

model edzesterv_gyakorlatok {
  id               Int         @id @default(autoincrement())
  edzes_nap_id     Int
  gyakorlat_id     Int
  sorrend          Int         @default(1)
  sorozatszam      Int?        @default(3)
  ismetlesszam_min Int?        @default(8)
  ismetlesszam_max Int?        @default(12)
  piheno_masodperc Int?        @default(90)
  megjegyzese      String?     @db.Text
  edzes_napok      edzes_napok @relation(fields: [edzes_nap_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "edzesterv_gyakorlatok_ibfk_1")
  gyakorlatok      gyakorlatok @relation(fields: [gyakorlat_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "edzesterv_gyakorlatok_ibfk_2")

  @@index([edzes_nap_id], map: "edzes_nap_id")
  @@index([gyakorlat_id], map: "gyakorlat_id")
  @@unique([edzes_nap_id, sorrend])
}

model edzestervek {
  id          Int           @id @default(autoincrement())
  user_id     Int
  nev         String        @db.VarChar(100)
  leiras      String?       @db.Text
  aktiv       Boolean?      @default(true)
  publikus    Boolean?      @default(false)
  letrehozva  DateTime      @default(now()) @db.Timestamp(0)
  edzes_napok edzes_napok[]
  userek      userek        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "edzestervek_ibfk_1")
  workoutSessions WorkoutSession[]
  sentShares PlanShare[] @relation("sourcePlan")
  copiedShares PlanShare[] @relation("copiedPlan")

  @@index([user_id], map: "user_id")
}

model userek {
  sessions AuthSession[]
  id          Int           @id @default(autoincrement())
  nev         String        @db.VarChar(100)
  username    String?       @unique @db.VarChar(40)
  username_normalized String? @unique @db.VarChar(40)
  bio         String?       @db.VarChar(500)
  avatar_url  String?       @db.VarChar(2048)
  profil_publikus Boolean   @default(true)
  email       String        @unique(map: "email") @db.VarChar(150)
  jelszo_hash String        @db.VarChar(255)
  suly_kg     Decimal?      @db.Decimal(5, 2)
  magassag_cm Int?
  eletkor     Int?
  nem         userek_nem?
  cel         userek_cel?   @default(izomtomeg_noveles)
  rang        userek_rang?  @default(tag)
  letrehozva  DateTime      @default(now()) @db.Timestamp(0)
  edzestervek edzestervek[]
  workoutSessions WorkoutSession[]
  sentPlanShares PlanShare[] @relation("shareSender")
  receivedPlanShares PlanShare[] @relation("shareRecipient")
  notifications Notification[]
  blocksInitiated UserBlock[] @relation("blocker")
  blocksReceived UserBlock[] @relation("blocked")
}

model kaja {
  id         Int            @id @default(autoincrement())
  nev        String         @unique(map: "kaja_nev_key") @db.VarChar(100)
  kategoria  kaja_kategoria
  kaloria    Decimal        @db.Decimal(6, 2)
  feherje    Decimal        @db.Decimal(5, 2)
  szenhidrat Decimal        @db.Decimal(5, 2)
  zsir       Decimal        @db.Decimal(5, 2)
}

enum userek_nem {
  ferfi
  no
  egyeb
}

enum userek_cel {
  izomtomeg_noveles
  fogyas
  erodobas
  szintentartas
}

enum userek_rang {
  tag
  edzo
  admin
}

enum kaja_kategoria {
  hus
  hal_tengeri
  tejtermek_tojas
  zoldseg
  gyumolcs
  gabonafele_teszta
  huvelyes
  magvas_zsir
}

model AuthSession {
  id String @id @default(uuid())
  userId Int
  user userek @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

enum WorkoutStatus {
  in_progress
  completed
  cancelled
}

model WorkoutSession {
  id Int @id @default(autoincrement())
  userId Int
  sourcePlanId Int?
  sourceDayId Int?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  status WorkoutStatus @default(in_progress)
  note String? @db.Text
  user userek @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcePlan edzestervek? @relation(fields: [sourcePlanId], references: [id], onDelete: SetNull)
  sourceDay edzes_napok? @relation(fields: [sourceDayId], references: [id], onDelete: SetNull)
  exercises SessionExercise[]
  @@index([userId, status, startedAt])
}

model SessionExercise {
  id Int @id @default(autoincrement())
  sessionId Int
  exerciseId Int?
  exerciseName String @db.VarChar(100)
  sorrend Int
  note String? @db.Text
  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise gyakorlatok? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets WorkoutSet[]
  @@unique([sessionId, sorrend])
}

model WorkoutSet {
  id Int @id @default(autoincrement())
  sessionExerciseId Int
  sorrend Int
  weight Decimal? @db.Decimal(7,2)
  repetitions Int
  rpe Decimal? @db.Decimal(3,1)
  completed Boolean @default(false)
  completedAt DateTime?
  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  @@unique([sessionExerciseId, sorrend])
}

enum PlanShareStatus {
  pending
  accepted
  declined
  revoked
  expired
}

model PlanShare {
  id Int @id @default(autoincrement())
  sourcePlanId Int
  senderId Int
  recipientId Int
  message String? @db.VarChar(500)
  status PlanShareStatus @default(pending)
  createdAt DateTime @default(now())
  respondedAt DateTime?
  expiresAt DateTime
  copiedPlanId Int? @unique
  sourcePlan edzestervek @relation("sourcePlan", fields: [sourcePlanId], references: [id], onDelete: Cascade)
  copiedPlan edzestervek? @relation("copiedPlan", fields: [copiedPlanId], references: [id], onDelete: SetNull)
  sender userek @relation("shareSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient userek @relation("shareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@index([recipientId, status, createdAt])
  @@index([senderId, status, createdAt])
  @@unique([sourcePlanId, recipientId, status])
}

enum NotificationType {
  plan_share_received
  plan_share_accepted
}

model Notification {
  id Int @id @default(autoincrement())
  recipientId Int
  type NotificationType
  resourceId Int?
  createdAt DateTime @default(now())
  readAt DateTime?
  recipient userek @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@index([recipientId, readAt, createdAt])
}

model UserBlock {
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  blocker userek @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked userek @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
  @@index([blockedId])
}
