generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model gyakorlatok {
  id                                                                 Int                     @id @default(autoincrement())
  nev                                                                String                  @db.VarChar(100)
  elsodleges_izomcsoport_id                                          Int
  masodlagos_izomcsoport_id                                          Int?
  edzesterv_gyakorlatok                                              edzesterv_gyakorlatok[]
  izomcsoportok_gyakorlatok_elsodleges_izomcsoport_idToizomcsoportok izomcsoportok           @relation("gyakorlatok_elsodleges_izomcsoport_idToizomcsoportok", fields: [elsodleges_izomcsoport_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "gyakorlatok_ibfk_1")
  izomcsoportok_gyakorlatok_masodlagos_izomcsoport_idToizomcsoportok izomcsoportok?          @relation("gyakorlatok_masodlagos_izomcsoport_idToizomcsoportok", fields: [masodlagos_izomcsoport_id], references: [id], onUpdate: Restrict, map: "gyakorlatok_ibfk_2")

  @@index([elsodleges_izomcsoport_id], map: "elsodleges_izomcsoport_id")
  @@index([masodlagos_izomcsoport_id], map: "masodlagos_izomcsoport_id")
}

model izomcsoportok {
  id                                                               Int           @id @default(autoincrement())
  nev                                                              String        @unique(map: "izomcsoportok_nev_key") @db.VarChar(50)
  gyakorlatok_gyakorlatok_elsodleges_izomcsoport_idToizomcsoportok gyakorlatok[] @relation("gyakorlatok_elsodleges_izomcsoport_idToizomcsoportok")
  gyakorlatok_gyakorlatok_masodlagos_izomcsoport_idToizomcsoportok gyakorlatok[] @relation("gyakorlatok_masodlagos_izomcsoport_idToizomcsoportok")
}

model edzes_napok {
  id                    Int                     @id @default(autoincrement())
  edzesterv_id          Int
  nev                   String                  @db.VarChar(100)
  sorrend               Int                     @default(1)
  edzestervek           edzestervek             @relation(fields: [edzesterv_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "edzes_napok_ibfk_1")
  edzesterv_gyakorlatok edzesterv_gyakorlatok[]

  @@index([edzesterv_id], map: "edzesterv_id")
}

model edzesterv_gyakorlatok {
  id               Int         @id @default(autoincrement())
  edzes_nap_id     Int
  gyakorlat_id     Int
  sorrend          Int         @default(1)
  sorozatszam      Int?        @default(3)
  ismetlesszam_min Int?        @default(8)
  ismetlesszam_max Int?        @default(12)
  piheno_masodperc Int?        @default(90)
  megjegyzese      String?     @db.Text
  edzes_napok      edzes_napok @relation(fields: [edzes_nap_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "edzesterv_gyakorlatok_ibfk_1")
  gyakorlatok      gyakorlatok @relation(fields: [gyakorlat_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "edzesterv_gyakorlatok_ibfk_2")

  @@index([edzes_nap_id], map: "edzes_nap_id")
  @@index([gyakorlat_id], map: "gyakorlat_id")
}

model edzestervek {
  id          Int           @id @default(autoincrement())
  user_id     Int
  nev         String        @db.VarChar(100)
  leiras      String?       @db.Text
  aktiv       Boolean?      @default(true)
  publikus    Boolean?      @default(false)
  letrehozva  DateTime      @default(now()) @db.Timestamp(0)
  edzes_napok edzes_napok[]
  userek      userek        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "edzestervek_ibfk_1")

  @@index([user_id], map: "user_id")
}

model userek {
  id          Int           @id @default(autoincrement())
  nev         String        @db.VarChar(100)
  email       String        @unique(map: "email") @db.VarChar(150)
  jelszo_hash String        @db.VarChar(255)
  suly_kg     Decimal?      @db.Decimal(5, 2)
  magassag_cm Int?
  eletkor     Int?
  nem         userek_nem?
  cel         userek_cel?   @default(izomtomeg_noveles)
  rang        userek_rang?  @default(tag)
  letrehozva  DateTime      @default(now()) @db.Timestamp(0)
  edzestervek edzestervek[]
}

model kaja {
  id         Int            @id @default(autoincrement())
  nev        String         @unique(map: "kaja_nev_key") @db.VarChar(100)
  kategoria  kaja_kategoria
  kaloria    Decimal        @db.Decimal(6, 2)
  feherje    Decimal        @db.Decimal(5, 2)
  szenhidrat Decimal        @db.Decimal(5, 2)
  zsir       Decimal        @db.Decimal(5, 2)
}

enum userek_nem {
  ferfi
  no
  egyeb
}

enum userek_cel {
  izomtomeg_noveles
  fogyas
  erodobas
  szintentartas
}

enum userek_rang {
  tag
  edzo
  admin
}

enum kaja_kategoria {
  hus
  hal_tengeri
  tejtermek_tojas
  zoldseg
  gyumolcs
  gabonafele_teszta
  huvelyes
  magvas_zsir
}
