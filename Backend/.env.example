# Backend szerver portja (Render automatikusan beállítja)
PORT=5000

# PostgreSQL adatbázis kapcsolati URL (Supabase connection pooling)
# Példa: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# PostgreSQL direkt kapcsolati URL (Supabase direct connection, migrációkhoz)
# Példa: postgresql://user:password@host:5432/database?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/database?sslmode=require

# Frontend URL (Vercel deploy URL), CORS engedélyezéshez
FRONTEND_URL=http://localhost:5173